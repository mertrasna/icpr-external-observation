# Raw evidence and local/private inputs must not be committed.
/FALLBACK_PIN_NOTE.md
/OPERATOR_RUNBOOK.md
client/*
!client/.gitkeep
server/*
!server/.gitkeep
feeds/apple/*
!feeds/apple/.gitkeep
derived/*
!derived/.gitkeep
reports/*
!reports/.gitkeep
manifests/*
!manifests/.gitkeep
config/ingress_pins.yaml
config/ingress_pins.yaml.sha256
config/experiment_config.yaml
reference/asn/origin_prefixes.csv
reference/asn/origin_prefixes.csv.sha256
